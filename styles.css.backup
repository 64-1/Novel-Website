:root {
  color-scheme: light;
  font-family: "Inter", "PingFang SC", "Microsoft YaHei", system-ui, -apple-system, sans-serif;
  --bg-base: #f5f7fb;
  --bg-gradient: linear-gradient(160deg, #f8fbff 0%, #eef2ff 40%, #ffffff 100%);
  --surface: #ffffff;
  --surface-alt: rgba(255, 255, 255, 0.8);
  --surface-soft: rgba(248, 250, 255, 0.85);
  --surface-strong: rgba(255, 255, 255, 0.92);
  --surface-stronger: rgba(255, 255, 255, 0.96);
  --surface-blur: rgba(248, 250, 255, 0.88);
  --surface-muted: rgba(15, 23, 42, 0.06);
  --primary: #3a70ff;
  --primary-soft: rgba(58, 112, 255, 0.12);
  --primary-accent: rgba(58, 112, 255, 0.18);
  --text-strong: #121926;
  --text-body: #334155;
  --text-muted: #64748b;
  --border: rgba(148, 163, 184, 0.25);
  --shadow-soft: 0 18px 40px rgba(15, 23, 42, 0.08);
  --radius-lg: 26px;
  --radius-md: 18px;
  --radius-sm: 12px;
  --transition: 220ms ease;
  --search-hit-bg: #ffe58f;
  --search-hit-current: #fff2ab;
  --search-hit-outline: #3a70ff;
}

body.dark-shell {
  color-scheme: dark;
  --bg-base: #0b1120;
  --bg-gradient: linear-gradient(160deg, #0b1220 0%, #0f172a 45%, #111827 100%);
  --surface: rgba(15, 23, 42, 0.85);
  --surface-alt: rgba(30, 41, 59, 0.7);
  --surface-soft: rgba(30, 41, 59, 0.78);
  --surface-strong: rgba(15, 23, 42, 0.92);
  --surface-stronger: rgba(14, 20, 35, 0.95);
  --surface-blur: rgba(11, 15, 28, 0.82);
  --surface-muted: rgba(51, 65, 85, 0.35);
  --primary: #8da2ff;
  --primary-soft: rgba(141, 162, 255, 0.2);
  --primary-accent: rgba(99, 102, 241, 0.26);
  --text-strong: #f8fafc;
  --text-body: #e2e8f0;
  --text-muted: #94a3b8;
  --border: rgba(51, 65, 85, 0.7);
  --shadow-soft: 0 18px 40px rgba(2, 6, 23, 0.65);
  --search-hit-bg: rgba(250, 204, 21, 0.35);
  --search-hit-current: rgba(250, 204, 21, 0.55);
  --search-hit-outline: #facc15;
}

*, *::before, *::after {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: var(--bg-gradient);
  color: var(--text-body);
  line-height: 1.6;
  min-height: 100vh;
  background-attachment: fixed;
}

section.hero,
.discover,
.reader-lab,
.writer-studio,
.community {
  content-visibility: auto;
  contain-intrinsic-size: 600px;
}

img {
  max-width: 100%;
  display: block;
}

a {
  color: inherit;
  text-decoration: none;
}

.visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0 0 0 0);
  white-space: nowrap;
  border: 0;
}

.container {
  width: min(1120px, 92vw);
  margin: 0 auto;
}

.site-header {
  position: sticky;
  top: 0;
  z-index: 30;
  background: var(--surface-blur);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--border);
  padding: 16px 0;
}

.header-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  flex-wrap: wrap;
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  font-weight: 700;
  font-size: 20px;
  color: var(--text-strong);
}

.brand-logo {
  width: 38px;
  height: 38px;
  display: grid;
  place-content: center;
  border-radius: 50%;
  background: linear-gradient(135deg, #5b8dff, #3a70ff);
  color: white;
  font-weight: 600;
  font-family: "Noto Serif SC", "Songti SC", serif;
  font-size: 18px;
  line-height: 1;
}

.primary-nav {
  display: flex;
  align-items: center;
  gap: 24px;
  font-size: 15px;
}

.primary-nav a {
  position: relative;
  padding: 6px 0;
  color: var(--text-muted);
  font-weight: 500;
  transition: color var(--transition);
}

.primary-nav a::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: -6px;
  width: 100%;
  height: 2px;
  border-radius: 2px;
  background: var(--primary);
  opacity: 0;
  transform: translateY(4px);
  transition: var(--transition);
}

.primary-nav a:hover,
.primary-nav a:focus-visible {
  color: var(--text-strong);
}

.primary-nav a:hover::after,
.primary-nav a:focus-visible::after {
  opacity: 1;
  transform: translateY(0);
}

.header-actions {
  display: flex;
  gap: 12px;
  align-items: center;
  flex-shrink: 0;
}

.header-search {
  position: relative;
  flex: 1 1 360px;
  max-width: 520px;
  min-width: 260px;
}

.search-wrap {
  position: relative;
}

#siteSearch {
  width: 100%;
  padding: 12px 16px;
  border-radius: 24px;
  border: 1px solid rgba(148, 163, 184, 0.4);
  background: var(--surface, #ffffff);
  color: var(--text-body, #334155);
  font-size: 15px;
  transition: box-shadow var(--transition), border-color var(--transition);
  position: relative;
  z-index: 51;
}

#siteSearch:focus {
  outline: none;
  border-color: var(--primary);
  box-shadow: 0 0 0 3px rgba(58, 112, 255, 0.18);
}

.results-panel {
  position: absolute;
  left: 0;
  right: 0;
  top: calc(100% + 8px);
  background: var(--surface, #ffffff);
  border: 1px solid rgba(148, 163, 184, 0.35);
  border-radius: 16px;
  box-shadow: 0 18px 40px rgba(15, 23, 42, 0.1);
  max-height: 60vh;
  overflow: hidden;
  padding: 8px;
  z-index: 50;
}

#searchResults {
  min-height: 0;
  overflow: hidden;
}

#searchResults[hidden] {
  display: none !important;
}

#searchResults:empty {
  display: none !important;
}

#searchResults.open.scrollable {
  overflow: auto;
}

.result-item {
  display: flex;
  gap: 12px;
  align-items: center;
  padding: 10px 12px;
  border-radius: 12px;
  cursor: pointer;
  color: inherit;
  text-decoration: none;
}

.result-item:hover,
.result-item:focus,
.result-item.active {
  background: rgba(58, 112, 255, 0.08);
}

.result-cover {
  width: 48px;
  height: 64px;
  object-fit: cover;
  border-radius: 8px;
  background: rgba(148, 163, 184, 0.2);
  flex-shrink: 0;
}

.result-meta {
  display: flex;
  flex-direction: column;
  gap: 4px;
  min-width: 0;
}

.result-title {
  font-weight: 600;
  font-size: 15px;
  color: var(--text-strong, #121926);
}

.result-sub {
  font-size: 12px;
  color: var(--text-muted, #64748b);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.result-empty {
  padding: 12px 14px;
  font-size: 14px;
  color: var(--text-muted, #64748b);
}

body.dark-shell #siteSearch {
  border-color: rgba(99, 102, 241, 0.4);
  background: var(--surface, rgba(15, 23, 42, 0.85));
  color: var(--text-body, #e2e8f0);
}

body.dark-shell .results-panel {
  background: var(--surface, rgba(15, 23, 42, 0.85));
  border-color: rgba(99, 102, 241, 0.35);
  box-shadow: 0 20px 40px rgba(2, 6, 23, 0.65);
}

body.dark-shell .result-item:hover,
body.dark-shell .result-item:focus,
body.dark-shell .result-item.active {
  background: rgba(141, 162, 255, 0.16);
}

body.dark-shell .result-title {
  color: var(--text-strong, #f8fafc);
}

body.dark-shell .result-sub {
  color: var(--text-muted, #94a3b8);
}

.search-page {
  background: var(--bg-gradient);
  min-height: 100vh;
}

.search-hero {
  padding: 72px 0 24px;
}

.search-hero h1 {
  margin-top: 12px;
  font-size: clamp(28px, 4vw, 40px);
  color: var(--text-strong);
}

.search-copy {
  margin: 8px 0 24px;
  color: var(--text-muted);
  max-width: 640px;
}

.search-page-form {
  margin-top: 12px;
}

.search-page-form input {
  width: min(100%, 680px);
  padding: 18px 22px;
  border-radius: 30px;
  border: 1px solid rgba(148, 163, 184, 0.4);
  background: var(--surface, #ffffff);
  font-size: 16px;
  color: var(--text-body);
  box-shadow: 0 12px 30px rgba(15, 23, 42, 0.08);
  transition: border-color var(--transition), box-shadow var(--transition);
}

.search-page-form input:focus {
  outline: none;
  border-color: var(--primary);
  box-shadow: 0 0 0 4px rgba(58, 112, 255, 0.18);
}

.search-status {
  margin-top: 18px;
  font-size: 14px;
  color: var(--text-muted);
}

.trending-section {
  padding: 72px 0 48px;
  position: relative;
}

.trending-section::before,
.trending-section::after {
  content: none;
}

.trending-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 24px;
  flex-wrap: wrap;
  margin-bottom: 24px;
}

.trending-list {
  display: grid;
  grid-auto-flow: column;
  grid-auto-columns: minmax(220px, 260px);
  gap: 20px;
  overflow-x: auto;
  padding-bottom: 8px;
  scroll-snap-type: x mandatory;
  scrollbar-width: thin;
}

.trending-list::-webkit-scrollbar {
  height: 6px;
}

.trending-list::-webkit-scrollbar-thumb {
  background: rgba(148, 163, 184, 0.35);
  border-radius: 999px;
}

.trending-card {
  background: var(--surface, #ffffff);
  border-radius: 20px;
  border: 1px solid rgba(148, 163, 184, 0.25);
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  text-decoration: none;
  color: inherit;
  box-shadow: none;
  transition: transform var(--transition), border-color var(--transition);
  scroll-snap-align: start;
  min-height: 220px;
}

.trending-card:hover,
.trending-card:focus-visible {
  transform: translateY(-4px);
  border-color: rgba(59, 130, 246, 0.35);
}

.trending-cover {
  width: 100%;
  position: relative;
  padding-top: 140px;
  border-radius: 16px;
  overflow: hidden;
  background: rgba(59, 130, 246, 0.12);
  border: none;
}

.trending-cover img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: inherit;
  z-index: 1;
  transition: transform var(--transition), filter var(--transition);
}

.trending-cover::before,
.trending-cover::after {
  content: none;
}

.cover-title {
  display: none;
}

.trending-cover--placeholder {
  background: linear-gradient(145deg, #3b82f6 0%, #6366f1 100%);
}

.trending-cover--placeholder::before {
  content: "";
  position: absolute;
  inset: 12px 16px 20px 16px;
  border-radius: 18px;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.68), rgba(96, 165, 250, 0.22));
  opacity: 0.7;
  pointer-events: none;
}

.trending-cover--placeholder::after {
  content: "";
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at 20% 20%, rgba(255, 255, 255, 0.24), transparent 60%),
    radial-gradient(circle at 80% 90%, rgba(96, 165, 250, 0.24), transparent 70%);
  mix-blend-mode: screen;
  pointer-events: none;
}

.trending-cover--placeholder .cover-title {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: flex-end;
  padding: 18px 20px;
  font-size: 18px;
  font-family: "Noto Serif SC", serif;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.92);
  text-shadow: 0 8px 16px rgba(15, 23, 42, 0.26);
  letter-spacing: 0.01em;
  background: linear-gradient(180deg, rgba(15, 23, 42, 0) 0%, rgba(15, 23, 42, 0.35) 85%, rgba(15, 23, 42, 0.6) 100%);
  border-radius: inherit;
  z-index: 2;
}

.trending-card:hover .trending-cover img,
.trending-card:focus-visible .trending-cover img {
  transform: scale(1.02);
  filter: saturate(110%) contrast(105%);
}

.trending-meta {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.trending-title {
  font-weight: 600;
  font-size: 16px;
  color: var(--text-strong, #121926);
  line-height: 1.4;
}

.trending-updated {
  font-size: 13px;
  color: var(--text-muted, #64748b);
}

.trending-empty {
  padding: 20px;
  border-radius: 16px;
  background: rgba(148, 163, 184, 0.16);
  color: var(--text-muted, #64748b);
  min-width: 220px;
  text-align: center;
}

.search-toolbar {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  margin-top: 20px;
}

.sort-label {
  font-size: 14px;
  color: var(--text-muted, #64748b);
}

#sortBy {
  appearance: none;
  border: 1px solid rgba(148, 163, 184, 0.35);
  border-radius: 999px;
  padding: 10px 32px 10px 16px;
  font-size: 14px;
  background: var(--bg, #fff);
  color: var(--text, #222);
  position: relative;
  cursor: pointer;
  box-shadow: 0 8px 18px rgba(15, 23, 42, 0.08);
}

#sortBy:focus {
  outline: none;
  border-color: var(--primary);
  box-shadow: 0 0 0 3px rgba(58, 112, 255, 0.18);
}

.search-results {
  padding: 24px 0 80px;
}

.search-results-list {
  display: grid;
  gap: 14px;
  margin-top: 12px;
}

.result-item.result-block {
  align-items: flex-start;
  gap: 16px;
  padding: 14px 18px;
  border-radius: 16px;
}

.result-item.result-block:hover,
.result-item.result-block:focus {
  transform: translateY(-1px);
}

.result-item.result-block .result-cover {
  width: 64px;
  height: 86px;
  border-radius: 10px;
}

.result-item.result-block .result-title {
  font-size: 18px;
}

.result-item.result-block .result-desc {
  margin-top: 6px;
  font-size: 13px;
  line-height: 1.5;
  color: var(--text-muted, #64748b);
}

.result-item.result-block .result-meta {
  gap: 6px;
}

body.dark-shell .search-page-form input {
  border-color: rgba(99, 102, 241, 0.4);
  background: var(--surface, rgba(15, 23, 42, 0.85));
  color: var(--text-body, #e2e8f0);
  box-shadow: 0 12px 30px rgba(2, 6, 23, 0.45);
}

body.dark-shell .search-status {
  color: var(--text-muted, #94a3b8);
}

body.dark-shell .result-item.result-block .result-desc {
  color: var(--text-muted, #94a3b8);
}

body.dark-shell .sort-label {
  color: var(--text-muted, #94a3b8);
}

body.dark-shell #sortBy {
  background: #0f141b;
  color: #e6e8ee;
  border-color: #263242;
  box-shadow: 0 12px 30px rgba(2, 6, 23, 0.45);
}

body.dark-shell .trending-card {
  background: rgba(15, 23, 42, 0.92);
  border-color: rgba(37, 99, 235, 0.3);
  box-shadow: none;
}

body.dark-shell .trending-card:hover,
body.dark-shell .trending-card:focus-visible {
  border-color: rgba(96, 165, 250, 0.5);
}

body.dark-shell .trending-title {
  color: var(--text-strong, #f8fafc);
}

body.dark-shell .trending-updated {
  color: var(--text-muted, #94a3b8);
}

body.dark-shell .trending-empty {
  background: rgba(37, 99, 235, 0.16);
  color: var(--text-muted, #94a3b8);
}

body.dark-shell .trending-cover {
  background: rgba(59, 130, 246, 0.18);
}

body.dark-shell .trending-cover--placeholder {
  background: linear-gradient(145deg, #2563eb 0%, #4338ca 100%);
}

body.dark-shell .trending-cover--placeholder::before {
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.45), rgba(148, 163, 184, 0.18));
  opacity: 0.6;
}

body.dark-shell .trending-cover--placeholder::after {
  background: radial-gradient(circle at 25% 25%, rgba(255, 255, 255, 0.25), transparent 60%),
    radial-gradient(circle at 80% 90%, rgba(96, 165, 250, 0.4), transparent 70%);
}

body.dark-shell .trending-cover--placeholder .cover-title {
  color: rgba(226, 232, 240, 0.95);
  text-shadow: 0 10px 18px rgba(2, 6, 23, 0.5);
  background: linear-gradient(180deg, rgba(2, 6, 23, 0.05) 0%, rgba(2, 6, 23, 0.45) 80%, rgba(2, 6, 23, 0.72) 100%);
}

body.dark-shell .music-card {
  background: linear-gradient(155deg, rgba(30, 41, 59, 0.95), rgba(17, 24, 39, 0.9));
  box-shadow: 0 30px 54px rgba(2, 6, 23, 0.55);
}

body.dark-shell .music-card p {
  color: rgba(226, 232, 240, 0.7);
}

body.dark-shell .music-select__trigger {
  background: linear-gradient(135deg, rgba(23, 32, 49, 0.95), rgba(37, 56, 92, 0.88));
  border-color: rgba(96, 165, 250, 0.28);
  color: #e0e7ff;
  box-shadow: 0 18px 38px rgba(2, 6, 23, 0.6);
}

body.dark-shell .music-select.is-open .music-select__trigger {
  border-color: rgba(96, 165, 250, 0.46);
  box-shadow: 0 26px 46px rgba(2, 6, 23, 0.68);
}

body.dark-shell .music-select__icon {
  background: rgba(96, 165, 250, 0.24);
}

body.dark-shell .music-select__icon::before {
  border-color: rgba(191, 219, 254, 0.85);
}

body.dark-shell .music-select__menu {
  background: rgba(15, 23, 42, 0.95);
  border-color: rgba(96, 165, 250, 0.32);
  box-shadow: 0 34px 60px rgba(2, 6, 23, 0.7);
}

body.dark-shell .music-select__option {
  color: #e0e7ff;
}

body.dark-shell .music-select__option:hover,
body.dark-shell .music-select__option:focus,
body.dark-shell .music-select__option.is-active {
  background: linear-gradient(120deg, rgba(59, 130, 246, 0.16), rgba(129, 140, 248, 0.18));
  color: #c7d2fe;
}

body.dark-shell .music-select__option.is-selected {
  background: linear-gradient(120deg, rgba(59, 130, 246, 0.22), rgba(79, 70, 229, 0.22));
  color: #ffffff;
  box-shadow: inset 0 0 0 1px rgba(129, 140, 248, 0.45);
}

/* Immersive reader */

body.immersive-reader {
  --reader-bg: #f7f0de;
  --reader-paper: #f7f0de;
  --reader-text: #2f2618;
  --reader-muted: rgba(47, 38, 24, 0.65);
  --reader-accent: #c28d4b;
  --reader-overlay: rgba(249, 240, 221, 0.88);
  margin: 0;
  min-height: 100vh;
  background: var(--reader-bg);
  color: var(--reader-text);
  font-family: "Noto Serif SC", "STZhongsong", serif;
  letter-spacing: 0.02em;
  transition: background 240ms ease, color 240ms ease;
}

body.immersive-reader[data-reader-theme="day"] {
  --reader-bg: #f5f7fb;
  --reader-paper: #ffffff;
  --reader-text: #202226;
  --reader-muted: rgba(32, 34, 38, 0.6);
  --reader-accent: #3b5bfd;
  --reader-overlay: rgba(244, 247, 255, 0.92);
}

body.immersive-reader[data-reader-theme="night"] {
  --reader-bg: #0d1117;
  --reader-paper: #131923;
  --reader-text: #e2e8f0;
  --reader-muted: rgba(226, 232, 240, 0.7);
  --reader-accent: #60a5fa;
  --reader-overlay: rgba(10, 14, 20, 0.9);
}

.immersive-layout {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
}

.immersive-stage {
  flex: 1;
  position: relative;
  display: flex;
  justify-content: center;
  background: radial-gradient(180% 100% at 50% 0%, rgba(255, 255, 255, 0.55), transparent),
    var(--reader-bg);
}

.immersive-scroll {
  width: 100%;
  max-width: 720px;
  margin: 0 auto;
  padding: clamp(68px, 10vh, 120px) clamp(18px, 6vw, 48px) clamp(120px, 14vh, 180px);
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  backdrop-filter: blur(2px);
}

.immersive-article {
  padding: clamp(24px, 4vw, 36px);
  background: var(--reader-paper);
  border-radius: 28px;
  box-shadow: 0 40px 90px rgba(15, 23, 42, 0.12), 0 12px 34px rgba(15, 23, 42, 0.1);
  border: 1px solid rgba(96, 70, 43, 0.08);
  color: inherit;
}

body.immersive-reader[data-reader-theme="night"] .immersive-article {
  box-shadow: 0 40px 80px rgba(2, 6, 23, 0.55), 0 16px 34px rgba(2, 6, 23, 0.45);
  border-color: rgba(148, 163, 184, 0.05);
}

.immersive-article h2,
.immersive-article h3 {
  font-size: clamp(26px, 4vw, 32px);
  font-weight: 600;
  margin: 0 0 22px;
  letter-spacing: 0.04em;
}

.immersive-article p {
  margin: 0 0 clamp(16px, 4vh, 24px);
  text-indent: 2em;
  line-height: 1.85;
  color: inherit;
}

.immersive-article p:first-of-type {
  margin-top: clamp(14px, 3vh, 20px);
}

.immersive-article p:last-child {
  margin-bottom: 0;
}

.immersive-topbar,
.immersive-toolbar {
  position: fixed;
  left: 0;
  right: 0;
  padding: 18px clamp(12px, 5vw, 32px);
  display: flex;
  align-items: center;
  gap: 18px;
  background: var(--reader-overlay);
  backdrop-filter: blur(16px);
  transition: opacity 220ms ease, transform 220ms ease;
  z-index: 20;
}

.immersive-topbar {
  top: 0;
  justify-content: space-between;
}

.immersive-toolbar {
  bottom: 0;
  flex-direction: column;
  gap: 16px;
}

[data-layer="chrome"][hidden] {
  opacity: 0;
  pointer-events: none;
}

body.chrome-open [data-layer="chrome"] {
  opacity: 1;
  pointer-events: auto;
}

.topbar-btn {
  width: 42px;
  height: 42px;
  border-radius: 16px;
  border: 1px solid rgba(99, 102, 241, 0.12);
  display: grid;
  place-items: center;
  background: rgba(255, 255, 255, 0.4);
  color: var(--reader-text);
  cursor: pointer;
  transition: transform var(--transition), box-shadow var(--transition);
}

body.immersive-reader[data-reader-theme="night"] .topbar-btn {
  background: rgba(30, 41, 59, 0.45);
  border-color: rgba(96, 165, 250, 0.2);
  color: #e2e8f0;
}

.topbar-btn:hover,
.topbar-btn:focus-visible {
  transform: translateY(-1px);
  box-shadow: 0 12px 24px rgba(79, 70, 229, 0.18);
}

.topbar-icon {
  position: relative;
  width: 18px;
  height: 18px;
  display: inline-block;
}

.topbar-icon--back::before {
  content: "";
  position: absolute;
  inset: 0;
  border-left: 2px solid currentColor;
  border-bottom: 2px solid currentColor;
  transform: translateX(4px) rotate(45deg);
}

.topbar-icon--share::before,
.topbar-icon--share::after {
  content: "";
  position: absolute;
  border-radius: 999px;
  background: currentColor;
}

.topbar-icon--share::before {
  width: 14px;
  height: 14px;
  border: 1.5px solid currentColor;
  background: transparent;
  top: 2px;
  left: 2px;
  opacity: 0.6;
}

.topbar-icon--share::after {
  width: 2px;
  height: 12px;
  left: 8px;
  top: 3px;
  transform: rotate(45deg);
  transform-origin: center;
}

.topbar-meta {
  flex: 1;
  min-width: 0;
}

.topbar-meta__label {
  display: block;
  font-size: 13px;
  color: var(--reader-muted);
  margin-bottom: 4px;
}

.topbar-meta__title {
  margin: 0;
  font-size: clamp(18px, 4vw, 22px);
  font-weight: 600;
  color: var(--reader-text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.topbar-meta__hint {
  margin: 6px 0 0;
  font-size: 13px;
  color: var(--reader-muted);
}

.toolbar-row {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}

.toolbar-row--nav {
  flex-wrap: wrap;
}

.toolbar-btn {
  border: none;
  background: rgba(255, 255, 255, 0.4);
  padding: 12px 20px;
  border-radius: 16px;
  font-size: 14px;
  font-weight: 600;
  color: var(--reader-text);
  cursor: pointer;
  transition: transform var(--transition), box-shadow var(--transition);
}

.toolbar-btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
  transform: none;
  box-shadow: none;
}

body.immersive-reader[data-reader-theme="night"] .toolbar-btn {
  background: rgba(32, 41, 57, 0.65);
  color: #e2e8f0;
}

.toolbar-btn:hover:not(:disabled),
.toolbar-btn:focus-visible:not(:disabled) {
  transform: translateY(-1px);
  box-shadow: 0 16px 28px rgba(79, 70, 229, 0.2);
}

.toolbar-btn--ghost {
  background: rgba(255, 255, 255, 0.32);
  border: 1px solid rgba(79, 70, 229, 0.12);
}

body.immersive-reader[data-reader-theme="night"] .toolbar-btn--ghost {
  background: rgba(32, 41, 57, 0.78);
  border-color: rgba(96, 165, 250, 0.28);
  color: #e2e8f0;
}

.toolbar-btn__icon {
  margin-right: 6px;
  font-size: 15px;
}

.toolbar-btn--wide {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  padding: 12px 24px;
  flex: 1;
  max-width: 280px;
}

.toolbar-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 20px;
  height: 20px;
  padding: 0 6px;
  border-radius: 999px;
  background: #f97316;
  color: #fff;
  font-size: 12px;
  font-weight: 600;
  margin-left: 8px;
  box-shadow: 0 6px 12px rgba(249, 115, 22, 0.25);
}

.toolbar-badge[hidden] {
  display: none;
}

.progress-group {
  display: flex;
  align-items: center;
  gap: 12px;
  flex: 1;
  max-width: 420px;
}

.immersive-progress {
  position: relative;
  flex: 1;
  height: 6px;
  border-radius: 999px;
  overflow: hidden;
}

.immersive-progress .progress-track {
  position: absolute;
  inset: 0;
  background: rgba(148, 163, 184, 0.25);
}

.immersive-progress .progress-fill {
  position: absolute;
  inset: 0;
  width: 0;
  border-radius: inherit;
  background: linear-gradient(120deg, rgba(79, 70, 229, 0.85), rgba(236, 196, 121, 0.9));
  transition: width 200ms ease;
}

body.immersive-reader[data-reader-theme="night"] .immersive-progress .progress-track {
  background: rgba(148, 163, 184, 0.32);
}

body.immersive-reader[data-reader-theme="night"] .immersive-progress .progress-fill {
  background: linear-gradient(120deg, rgba(59, 130, 246, 0.8), rgba(129, 140, 248, 0.85));
}

.progress-label {
  font-size: 13px;
  color: var(--reader-muted);
  min-width: 42px;
  text-align: right;
}

.highlight-popover {
  position: absolute;
  display: flex;
  gap: 10px;
  padding: 10px 12px;
  border-radius: 18px;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 18px 36px rgba(15, 23, 42, 0.22);
  border: 1px solid rgba(79, 70, 229, 0.18);
  transform: translate(-50%, calc(-100% - 18px));
  opacity: 0;
  pointer-events: none;
  transition: opacity 160ms ease, transform 160ms ease;
  z-index: 30;
}

.highlight-popover.is-visible {
  opacity: 1;
  pointer-events: auto;
  transform: translate(-50%, calc(-100% - 12px));
}

body.immersive-reader[data-reader-theme="night"] .highlight-popover {
  background: rgba(23, 32, 49, 0.92);
  border-color: rgba(96, 165, 250, 0.28);
  box-shadow: 0 22px 44px rgba(2, 6, 23, 0.6);
}

.highlight-swatch {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  border: 2px solid transparent;
  cursor: pointer;
  transition: transform 150ms ease, box-shadow 150ms ease, border-color 150ms ease;
}

.highlight-swatch:focus-visible,
.highlight-swatch:hover {
  transform: translateY(-2px);
  border-color: rgba(45, 55, 72, 0.2);
  box-shadow: 0 8px 16px rgba(15, 23, 42, 0.18);
}

.highlight-swatch--ylw {
  background: linear-gradient(135deg, #fce47b, #f6d165);
}

.highlight-swatch--grn {
  background: linear-gradient(135deg, #b4f0c2, #7ddf9c);
}

.highlight-swatch--blu {
  background: linear-gradient(135deg, #c1dcff, #8bb8ff);
}

.highlight-swatch--pnk {
  background: linear-gradient(135deg, #ffd0e8, #fba7c6);
}

.theme-group {
  display: inline-flex;
  gap: 10px;
  align-items: center;
}

.theme-pill {
  border: none;
  padding: 10px 18px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.55);
  font-size: 13px;
  font-weight: 600;
  color: var(--reader-muted);
  cursor: pointer;
  transition: transform var(--transition), box-shadow var(--transition), background var(--transition), color var(--transition);
}

.theme-pill.active {
  background: linear-gradient(120deg, rgba(79, 70, 229, 0.22), rgba(236, 196, 121, 0.28));
  color: var(--reader-accent);
  box-shadow: 0 12px 24px rgba(79, 70, 229, 0.17);
}

.theme-pill:hover {
  transform: translateY(-1px);
}

body.immersive-reader[data-reader-theme="night"] .theme-pill {
  background: rgba(37, 46, 64, 0.75);
  color: rgba(226, 232, 240, 0.65);
}

body.immersive-reader[data-reader-theme="night"] .theme-pill.active {
  background: linear-gradient(120deg, rgba(59, 130, 246, 0.32), rgba(129, 140, 248, 0.28));
  color: #f8fafc;
}

.slider-group {
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 13px;
  color: var(--reader-muted);
}

.slider-group label {
  font-weight: 500;
}

.slider-group input[type="range"] {
  width: 140px;
  accent-color: rgba(79, 70, 229, 0.65);
}

body.immersive-reader[data-reader-theme="night"] .slider-group input[type="range"] {
  accent-color: rgba(96, 165, 250, 0.8);
}

.slider-value {
  min-width: 44px;
  text-align: right;
}

.annotations-drawer {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 40;
  transition: opacity 220ms ease;
  opacity: 0;
}

.annotations-drawer.is-open {
  opacity: 1;
  pointer-events: auto;
}

.annotations-drawer__backdrop {
  position: absolute;
  inset: 0;
  background: rgba(15, 23, 42, 0.35);
  backdrop-filter: blur(6px);
  opacity: 0;
  transition: opacity 200ms ease;
}

.annotations-drawer.is-open .annotations-drawer__backdrop {
  opacity: 1;
}

.annotations-drawer__panel {
  position: absolute;
  top: 0;
  right: 0;
  width: min(360px, 90vw);
  height: 100%;
  background: var(--reader-overlay);
  backdrop-filter: blur(18px);
  box-shadow: -32px 0 60px rgba(15, 23, 42, 0.18);
  transform: translateX(100%);
  transition: transform 240ms cubic-bezier(0.22, 0.61, 0.36, 1);
  display: flex;
  flex-direction: column;
  padding: 24px;
  gap: 20px;
}

.annotations-drawer.is-open .annotations-drawer__panel {
  transform: translateX(0);
}

.annotations-drawer__header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12px;
}

.annotations-drawer__actions {
  display: inline-flex;
  align-items: center;
  gap: 10px;
}

.annotations-drawer__header h2 {
  margin: 0;
  font-size: 22px;
  color: var(--reader-text);
}

.annotations-drawer__subtitle {
  margin: 6px 0 0;
  font-size: 13px;
  color: var(--reader-muted);
}

.annotations-drawer__close {
  border: none;
  background: rgba(255, 255, 255, 0.45);
  border-radius: 12px;
  width: 34px;
  height: 34px;
  font-size: 18px;
  cursor: pointer;
  color: var(--reader-text);
  transition: transform var(--transition), box-shadow var(--transition);
}

body.immersive-reader[data-reader-theme="night"] .annotations-drawer__close {
  background: rgba(37, 48, 66, 0.75);
  color: #e2e8f0;
}

.annotations-drawer__close:hover,
.annotations-drawer__close:focus-visible {
  transform: translateY(-2px);
  box-shadow: 0 12px 24px rgba(79, 70, 229, 0.18);
}

.annotations-drawer__bookmark {
  border: none;
  background: rgba(79, 70, 229, 0.18);
  color: var(--reader-text);
  border-radius: 12px;
  width: 36px;
  height: 36px;
  font-size: 18px;
  line-height: 1;
  cursor: pointer;
  transition: transform var(--transition), box-shadow var(--transition);
}

.annotations-drawer__bookmark:hover,
.annotations-drawer__bookmark:focus-visible {
  transform: translateY(-2px);
  box-shadow: 0 12px 22px rgba(79, 70, 229, 0.22);
}

body.immersive-reader[data-reader-theme="night"] .annotations-drawer__bookmark {
  background: rgba(59, 130, 246, 0.25);
  color: #f8fafc;
}

.annotations-drawer__tabs {
  display: inline-flex;
  gap: 12px;
}

.drawer-tab {
  border: none;
  background: rgba(255, 255, 255, 0.5);
  border-radius: 999px;
  padding: 10px 18px;
  font-size: 14px;
  font-weight: 600;
  color: var(--reader-muted);
  cursor: pointer;
  transition: transform var(--transition), box-shadow var(--transition), background var(--transition);
  display: inline-flex;
  align-items: center;
  gap: 8px;
}

.drawer-tab.active {
  background: linear-gradient(120deg, rgba(79, 70, 229, 0.2), rgba(236, 196, 121, 0.26));
  color: var(--reader-text);
  box-shadow: 0 12px 24px rgba(79, 70, 229, 0.18);
}

body.immersive-reader[data-reader-theme="night"] .drawer-tab {
  background: rgba(37, 48, 66, 0.75);
  color: rgba(226, 232, 240, 0.7);
}

body.immersive-reader[data-reader-theme="night"] .drawer-tab.active {
  background: linear-gradient(120deg, rgba(59, 130, 246, 0.32), rgba(129, 140, 248, 0.28));
  color: #f8fafc;
}

.drawer-tab__count {
  min-width: 20px;
  height: 20px;
  border-radius: 999px;
  background: rgba(79, 70, 229, 0.16);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  color: var(--reader-text);
}

body.immersive-reader[data-reader-theme="night"] .drawer-tab__count {
  background: rgba(96, 165, 250, 0.18);
  color: #e2e8f0;
}

.annotations-drawer__body {
  flex: 1;
  overflow-y: auto;
  padding-right: 4px;
  display: grid;
  gap: 12px;
}

.annotation-item {
  background: rgba(255, 255, 255, 0.58);
  border-radius: 18px;
  padding: 16px 18px;
  border: 1px solid rgba(79, 70, 229, 0.1);
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 14px;
  cursor: pointer;
  transition: transform var(--transition), box-shadow var(--transition);
}

.annotation-item:hover,
.annotation-item:focus-visible {
  transform: translateY(-2px);
  box-shadow: 0 16px 28px rgba(15, 23, 42, 0.14);
}

body.immersive-reader[data-reader-theme="night"] .annotation-item {
  background: rgba(23, 32, 49, 0.78);
  border-color: rgba(96, 165, 250, 0.18);
  color: #e2e8f0;
}

.annotation-content {
  flex: 1;
  min-width: 0;
}

.annotation-snippet,
.annotation-note {
  margin: 0 0 8px;
  font-size: 14px;
  color: var(--reader-text);
}

.annotation-note {
  color: var(--reader-muted);
  font-size: 13px;
}

.annotation-meta {
  font-size: 12px;
  color: var(--reader-muted);
}

.annotation-delete {
  border: none;
  background: rgba(249, 115, 22, 0.16);
  color: #b45309;
  border-radius: 12px;
  width: 28px;
  height: 28px;
  font-size: 16px;
  cursor: pointer;
  transition: transform var(--transition), box-shadow var(--transition);
}

.annotation-delete:hover,
.annotation-delete:focus-visible {
  transform: translateY(-2px);
  box-shadow: 0 12px 20px rgba(249, 115, 22, 0.22);
}

body.immersive-reader[data-reader-theme="night"] .annotation-delete {
  background: rgba(248, 113, 113, 0.18);
  color: #fecaca;
}

.annotation-item--toc {
  justify-content: space-between;
  align-items: center;
  border: 1px solid transparent;
}

.annotation-item--toc.is-active {
  border-color: rgba(79, 70, 229, 0.25);
  box-shadow: 0 14px 30px rgba(79, 70, 229, 0.18);
}

body.immersive-reader[data-reader-theme="night"] .annotation-item--toc.is-active {
  border-color: rgba(96, 165, 250, 0.35);
  box-shadow: 0 18px 36px rgba(2, 6, 23, 0.6);
}

.annotation-toc-arrow {
  font-size: 20px;
  color: var(--reader-muted);
  align-self: center;
}

.annotations-empty {
  text-align: center;
  padding: 32px 12px;
  font-size: 14px;
  color: var(--reader-muted);
}

.immersive-toast {
  position: fixed;
  left: 50%;
  bottom: clamp(120px, 18vh, 180px);
  transform: translate(-50%, 20px);
  background: rgba(70, 49, 26, 0.88);
  color: #f8fafc;
  padding: 12px 18px;
  border-radius: 999px;
  box-shadow: 0 18px 36px rgba(15, 23, 42, 0.24);
  font-size: 14px;
  opacity: 0;
  pointer-events: none;
  transition: opacity 160ms ease, transform 160ms ease;
  z-index: 50;
}

.immersive-toast.is-visible {
  opacity: 1;
  transform: translate(-50%, 0);
}

body.immersive-reader[data-reader-theme="day"] .immersive-toast {
  background: rgba(30, 64, 175, 0.9);
}

body.immersive-reader[data-reader-theme="night"] .immersive-toast {
  background: rgba(15, 23, 42, 0.78);
}

mark.hl {
  background: rgba(252, 228, 123, 0.6);
  border-radius: 4px;
  padding: 0 2px;
  box-shadow: inset 0 -0.15em 0 rgba(255, 255, 255, 0.3);
  transition: box-shadow 200ms ease, background 200ms ease;
}

mark.hl.hl--grn {
  background: rgba(180, 240, 194, 0.55);
}

mark.hl.hl--blu {
  background: rgba(193, 220, 255, 0.55);
}

mark.hl.hl--pnk {
  background: rgba(255, 208, 232, 0.58);
}

body.immersive-reader[data-reader-theme="night"] mark.hl {
  background: rgba(253, 224, 71, 0.35);
  box-shadow: inset 0 -0.15em 0 rgba(15, 23, 42, 0.5);
}

body.immersive-reader[data-reader-theme="night"] mark.hl.hl--grn {
  background: rgba(74, 222, 128, 0.28);
}

body.immersive-reader[data-reader-theme="night"] mark.hl.hl--blu {
  background: rgba(96, 165, 250, 0.32);
}

body.immersive-reader[data-reader-theme="night"] mark.hl.hl--pnk {
  background: rgba(244, 114, 182, 0.32);
}

mark.hl:hover {
  box-shadow: inset 0 0 0 2px rgba(79, 70, 229, 0.24);
}

mark.hl.is-current {
  animation: highlightPulse 1.6s ease;
}

@keyframes highlightPulse {
  0% {
    box-shadow: inset 0 0 0 0 rgba(79, 70, 229, 0.35);
  }
  50% {
    box-shadow: inset 0 0 0 8px rgba(79, 70, 229, 0.08);
  }
  100% {
    box-shadow: inset 0 0 0 0 rgba(79, 70, 229, 0);
  }
}

.immersive-fallback-message {
  margin: 0;
  padding: 32px;
  text-align: center;
  font-size: 16px;
  color: var(--reader-muted);
}

@media (max-width: 720px) {
  .immersive-scroll {
    padding: 80px 18px 140px;
  }

  .immersive-article {
    border-radius: 20px;
    padding: 22px;
  }

  .toolbar-row {
    flex-direction: column;
    align-items: stretch;
    gap: 14px;
  }

  .progress-group {
    max-width: none;
    width: 100%;
  }

  .theme-group {
    width: 100%;
    justify-content: space-between;
  }

  .toolbar-btn--wide {
    max-width: none;
    width: 100%;
  }

  .slider-group {
    width: 100%;
    justify-content: space-between;
  }
}

@media (max-width: 480px) {
  .topbar-btn {
    width: 38px;
    height: 38px;
  }

  .theme-pill {
    padding: 8px 14px;
  }

  .slider-group input[type="range"] {
    width: 120px;
  }
}

@media (max-width: 960px) {
  .header-search {
    order: 4;
    flex: 1 1 100%;
    max-width: none;
  }
  .header-actions {
    order: 3;
    margin-left: auto;
  }
  .primary-nav {
    flex-wrap: wrap;
    gap: 16px;
  }
  .trending-head {
    align-items: flex-start;
  }
  .trending-list {
    grid-auto-columns: minmax(200px, 72vw);
  }
}

@media (max-width: 680px) {
  .header-inner {
    gap: 16px;
  }
  .header-actions {
    width: 100%;
    justify-content: flex-start;
    gap: 8px;
  }
  #siteSearch {
    font-size: 14px;
  }
  .search-hero {
    padding: 56px 0 20px;
  }
  .search-page-form input {
    width: 100%;
    padding: 16px 18px;
  }
  .result-item.result-block {
    padding: 12px 14px;
  }
  .result-item.result-block .result-title {
    font-size: 16px;
  }
  .search-toolbar {
    margin-top: 16px;
  }
  #sortBy {
    padding-right: 28px;
  }
  .trending-section {
    padding: 56px 0 40px;
  }
  .trending-list {
    grid-auto-columns: minmax(180px, 85vw);
  }
}

.btn {
  border: none;
  border-radius: 999px;
  padding: 10px 22px;
  font-weight: 600;
  font-size: 15px;
  cursor: pointer;
  transition: transform var(--transition), box-shadow var(--transition);
  display: inline-flex;
  align-items: center;
  gap: 8px;
}

.btn.primary {
  background: linear-gradient(130deg, #5b8dff, #3a70ff);
  color: white;
  box-shadow: 0 12px 24px rgba(58, 112, 255, 0.25);
}

.btn.primary:hover {
  transform: translateY(-1px);
  box-shadow: 0 16px 28px rgba(58, 112, 255, 0.32);
}

.btn.secondary {
  background: var(--surface);
  color: var(--text-strong);
  border: 1px solid var(--primary-accent);
}

.btn.ghost {
  background: transparent;
  color: var(--text-muted);
  border: 1px solid var(--border);
}

.btn.ghost:hover,
.btn.secondary:hover {
  transform: translateY(-1px);
  color: var(--text-strong);
}

.hero {
  padding: 96px 0 84px;
  position: relative;
}

.hero::before {
  content: "";
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at 25% 20%, rgba(99, 102, 241, 0.22), transparent 60%),
              radial-gradient(circle at 70% 5%, rgba(56, 189, 248, 0.18), transparent 55%);
  z-index: -2;
}

.hero-inner {
  display: grid;
  grid-template-columns: 1.15fr 0.85fr;
  gap: 52px;
  align-items: center;
}

.hero-copy h1 {
  font-family: "Noto Serif SC", "STZhongsong", serif;
  font-size: clamp(36px, 5vw, 48px);
  color: var(--text-strong);
  margin-bottom: 16px;
  line-height: 1.2;
}

.hero-copy .subhead {
  font-size: 16px;
  color: var(--text-muted);
  margin-bottom: 28px;
  max-width: 520px;
}

.highlight {
  display: inline-block;
  padding: 6px 14px;
  background: rgba(103, 126, 255, 0.12);
  border-radius: 999px;
  font-weight: 600;
  font-size: 14px;
  color: #3b5bfd;
  margin-bottom: 18px;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
}

#continue-reading-slot {
  margin-top: 24px;
  max-width: 360px;
}

.continue-reading-card {
  display: grid;
  gap: 12px;
}

.continue-reading-title {
  margin: 0;
  font-size: 15px;
  color: var(--text-strong);
}

.continue-reading-meta {
  font-size: 13px;
  color: var(--text-muted);
}

.hero-visual {
  position: relative;
}

.hero-card {
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.9), rgba(233, 243, 255, 0.84));
  border-radius: var(--radius-lg);
  padding: 32px;
  padding-right: clamp(32px, 12vw, 220px);
  box-shadow: var(--shadow-soft);
  backdrop-filter: blur(16px);
  position: relative;
}

.hero-card h3 {
  margin: 0 0 14px;
  font-family: "Noto Serif SC", "STSong", serif;
  font-size: 22px;
  color: var(--text-strong);
}

.hero-card p {
  margin: 0 0 18px;
  color: var(--text-muted);
  font-size: 15px;
}

.标签 {
  display: flex;
  gap: 12px;
  margin-bottom: 20px;
}

.标签 span {
  padding: 6px 14px;
  border-radius: 999px;
  background: rgba(59, 130, 246, 0.12);
  font-size: 13px;
  color: #2563eb;
}

.progress {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.progress span:first-child {
  font-size: 13px;
  color: var(--text-muted);
}

.progress-bar {
  flex: 1;
  height: 8px;
  border-radius: 999px;
  background: rgba(148, 163, 184, 0.2);
  position: relative;
  overflow: hidden;
}

.progress-bar span {
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background: linear-gradient(120deg, #60a5fa, #818cf8);
  transition: width 260ms ease;
}

.hero-floating {
  display: grid;
  gap: 16px;
  position: absolute;
  right: -24px;
  bottom: -24px;
}

.floating-card {
  background: var(--surface-strong);
  box-shadow: 0 16px 32px rgba(15, 23, 42, 0.12);
  padding: 18px 22px;
  border-radius: 18px;
  backdrop-filter: blur(16px);
}

.floating-card .meta {
  margin: 0;
  font-size: 13px;
  color: var(--text-muted);
}

.floating-card strong {
  font-size: 22px;
  color: var(--text-strong);
  display: block;
  margin: 4px 0 6px;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 28px;
  margin-bottom: 32px;
}

.eyebrow {
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: rgba(99, 102, 241, 0.8);
  margin-bottom: 10px;
}

.section-header h2 {
  margin: 0 0 12px;
  font-size: clamp(26px, 4vw, 34px);
  font-family: "Noto Serif SC", serif;
  color: var(--text-strong);
}

.section-subtitle {
  margin: 0;
  color: var(--text-muted);
  max-width: 520px;
  font-size: 15px;
}

.discover {
  padding: 84px 0 96px;
}

.discovery-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 24px;
}

.story-card {
  position: relative;
  border-radius: var(--radius-lg);
  overflow: hidden;
  color: white;
  min-height: 280px;
  padding: 24px;
  display: flex;
  align-items: flex-end;
  box-shadow: 0 24px 50px rgba(15, 23, 42, 0.18);
  background-size: cover;
  background-position: center;
}

.story-card .card-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(15, 23, 42, 0.15), rgba(15, 23, 42, 0.65));
}

.story-card .tag {
  display: inline-block;
  padding: 6px 14px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.16);
  font-size: 13px;
  margin-bottom: 16px;
}

.story-card h3 {
  font-size: 22px;
  margin: 0 0 10px;
  font-family: "Noto Serif SC", serif;
}

.story-card p {
  margin: 0 0 18px;
  font-size: 15px;
  color: rgba(255, 255, 255, 0.72);
}

.story-card .card-meta {
  display: flex;
  gap: 18px;
  font-size: 13px;
  color: rgba(255, 255, 255, 0.65);
}

.story-card.accent-blue {
  background-image: linear-gradient(135deg, #4f46e5, #38bdf8);
}

.story-card.accent-rose {
  background-image: linear-gradient(135deg, #ec4899, #f97316);
}

.story-card.accent-gold {
  background-image: linear-gradient(135deg, #fbbf24, #f59e0b);
}

.story-card.accent-violet {
  background-image: linear-gradient(135deg, #818cf8, #a855f7);
}

.reader-lab {
  padding: 88px 0 96px;
}

.reader-grid {
  display: grid;
  grid-template-columns: 0.28fr 1fr;
  gap: 36px;
  align-items: start;
}

.reader-grid.expanded {
  grid-template-columns: 0.22fr 1.2fr;
}

.reader-grid.expanded .reader-panel {
  padding: 32px 36px 40px;
}

.reader-grid.expanded .reader-content {
  max-width: 720px;
}

.toc {
  position: sticky;
  top: 120px;
  background: var(--surface);
  border-radius: var(--radius-md);
  padding: 26px;
  box-shadow: var(--shadow-soft);
}

.toc h4 {
  margin: 0 0 16px;
  font-size: 16px;
  font-weight: 600;
  color: var(--text-strong);
}

.toc ol {
  list-style: none;
  margin: 0 0 24px;
  padding: 0;
  display: grid;
  gap: 10px;
}

.toc li {
  padding: 10px 14px;
  border-radius: 12px;
  font-size: 14px;
  color: var(--text-muted);
  cursor: pointer;
  transition: background var(--transition), color var(--transition);
}

.toc li:hover {
  background: rgba(99, 102, 241, 0.08);
  color: var(--text-strong);
}

.toc li.active {
  background: rgba(99, 102, 241, 0.12);
  color: var(--primary);
  font-weight: 600;
}

.reader-stats {
  font-size: 13px;
  color: var(--text-muted);
}

.progress-bar.slim {
  height: 6px;
  margin: 10px 0;
}

.progress-bar.slim .progress-fill {
  display: block;
  width: 68%;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(120deg, #818cf8, #4338ca);
}

.reader-panel {
  position: relative;
  background: var(--surface-strong);
  border-radius: var(--radius-lg);
  padding: 26px 28px 32px;
  box-shadow: var(--shadow-soft);
}

.reader-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 16px;
  margin-bottom: 24px;
}

.reader-search {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
  margin-left: auto;
}

.reader-search input {
  flex: 1 1 190px;
  min-width: 160px;
  padding: 6px 12px;
  border-radius: 999px;
  border: 1px solid var(--border);
  background: var(--surface);
  color: var(--text-body);
  transition: border var(--transition), box-shadow var(--transition);
}

.reader-search input:focus {
  outline: none;
  border-color: rgba(99, 102, 241, 0.6);
  box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.18);
}

.search-controls {
  display: inline-flex;
  align-items: center;
  gap: 6px;
}

.search-controls button {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  border: 1px solid var(--border);
  background: var(--surface);
  color: var(--text-muted);
  font-size: 14px;
  line-height: 1;
  cursor: pointer;
  transition: background var(--transition), color var(--transition), transform var(--transition);
}

.search-controls button:hover,
.search-controls button:focus-visible {
  color: var(--text-strong);
  background: var(--surface-soft);
  transform: translateY(-1px);
}

#chap-search-status {
  font-size: 12px;
  color: var(--text-muted);
  min-width: 100px;
  white-space: nowrap;
}

.toolbar-group {
  display: flex;
  align-items: center;
  gap: 18px;
  font-size: 13px;
  color: var(--text-muted);
  font-weight: 500;
}

.toolbar-group label {
  display: flex;
  align-items: center;
  gap: 10px;
}

.toolbar-group input[type="range"] {
  accent-color: var(--primary);
}

.theme-toggle {
  background: rgba(99, 102, 241, 0.08);
  padding: 6px;
  border-radius: 999px;
}

.theme-toggle .pill {
  border: none;
  background: transparent;
  border-radius: 999px;
  padding: 8px 14px;
  font-size: 13px;
  font-weight: 600;
  color: #6366f1;
  cursor: pointer;
  transition: background var(--transition), color var(--transition), transform var(--transition);
}

.theme-toggle .pill.active {
  background: white;
  color: #312e81;
  box-shadow: 0 8px 18px rgba(99, 102, 241, 0.18);
}

.reader-content {
  font-size: 18px;
  line-height: 1.65;
  color: var(--text-body);
  background: var(--surface-soft);
  border-radius: var(--radius-md);
  padding: 32px 36px;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.6);
  font-family: "Noto Serif SC", "Songti SC", serif;
  transition: background var(--transition), color var(--transition);
  content-visibility: auto;
}

.chap-hit {
  background: var(--search-hit-bg);
  color: inherit;
  padding: 0 0.08em;
  border-radius: 4px;
}

.chap-hit.is-current {
  background: var(--search-hit-current);
  outline: 2px solid var(--search-hit-outline);
  outline-offset: 1px;
}

.reading-meta {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 20px;
  color: var(--text-muted);
  font-size: 13px;
}

.reading-time {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 12px;
  border-radius: 999px;
  background: rgba(59, 130, 246, 0.12);
  color: #2563eb;
  font-weight: 600;
}

.reader-content h3 {
  margin-top: 0;
  margin-bottom: 20px;
  font-size: 24px;
  color: #1e293b;
}

.reader-content p {
  margin: 0 0 20px;
  text-align: justify;
}

.reader-content blockquote,
.modal-article blockquote {
  margin: 28px 0;
  padding: 16px 20px;
  border-left: 3px solid #818cf8;
  background: rgba(129, 140, 248, 0.12);
  color: #312e81;
  font-size: 16px;
  border-radius: 12px;
}

.reader-content[data-theme="dusk"],
.modal-article[data-theme="dusk"] {
  background: #fdf6e3;
  color: #564132;
}

.reader-content[data-theme="dusk"] blockquote,
.modal-article[data-theme="dusk"] blockquote {
  border-color: #f59e0b;
  background: rgba(245, 158, 11, 0.12);
  color: #7c4e05;
}

.reader-content[data-theme="night"],
.modal-article[data-theme="night"] {
  background: #0f172a;
  color: #e2e8f0;
}

.reader-content[data-theme="night"] h3,
.modal-article[data-theme="night"] h3 {
  color: #f8fafc;
}

.reader-content[data-theme="night"] blockquote,
.modal-article[data-theme="night"] blockquote {
  border-color: #38bdf8;
  background: rgba(56, 189, 248, 0.12);
  color: #bae6fd;
}

.writer-studio {
  padding: 88px 0 96px;
}

.writer-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 0.38fr;
  gap: 32px;
}

.writer-panel {
  background: var(--surface-stronger);
  border-radius: var(--radius-lg);
  padding: 28px;
  box-shadow: var(--shadow-soft);
}

.writer-tabs {
  display: inline-flex;
  gap: 12px;
  background: rgba(99, 102, 241, 0.08);
  padding: 6px;
  border-radius: 999px;
  margin-bottom: 24px;
}

.tab {
  border: none;
  background: transparent;
  border-radius: 999px;
  padding: 10px 20px;
  font-weight: 600;
  color: #6366f1;
  cursor: pointer;
  transition: background var(--transition);
}

.tab.active {
  background: white;
  color: #312e81;
  box-shadow: 0 10px 20px rgba(99, 102, 241, 0.18);
}

.writer-panels .panel {
  display: none;
}

.writer-panels .panel.active {
  display: block;
}

.writer-panel h3 {
  margin-top: 0;
  font-size: 22px;
  font-family: "Noto Serif SC", serif;
  color: var(--text-strong);
}

.note-list {
  list-style: none;
  margin: 24px 0 0;
  padding: 0;
  display: grid;
  gap: 18px;
}

.note-list li {
  background: rgba(99, 102, 241, 0.08);
  border-radius: var(--radius-sm);
  padding: 18px;
}

.note-list strong {
  display: block;
  font-size: 15px;
  margin-bottom: 8px;
  color: #312e81;
}

.note-list p {
  margin: 0;
  font-size: 14px;
  color: #4b5563;
}

.input-label {
  display: block;
  font-size: 14px;
  font-weight: 600;
  color: var(--text-muted);
  margin: 14px 0 6px;
}

input[type="text"],
textarea,
select {
  width: 100%;
  padding: 14px 16px;
  border-radius: 14px;
  border: 1px solid rgba(148, 163, 184, 0.35);
  background: rgba(248, 250, 255, 0.8);
  font-size: 15px;
  color: var(--text-body);
  transition: border var(--transition), box-shadow var(--transition);
  font-family: inherit;
}

input[type="text"]:focus,
textarea:focus,
select:focus {
  outline: none;
  border-color: rgba(99, 102, 241, 0.6);
  box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.18);
}

textarea {
  resize: vertical;
  min-height: 260px;
}

.writer-meta {
  margin-top: 18px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  font-size: 14px;
  color: var(--text-muted);
}

.autosave-status {
  font-size: 13px;
  color: var(--text-muted);
  min-height: 18px;
  transition: color var(--transition), opacity var(--transition);
}

.autosave-status.saving {
  color: var(--primary);
}

.writer-actions {
  margin-top: 16px;
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

.preview-article {
  background: rgba(15, 23, 42, 0.88);
  color: white;
  padding: 28px;
  border-radius: var(--radius-md);
  font-family: "Noto Serif SC", serif;
  line-height: 1.7;
  box-shadow: 0 20px 40px rgba(15, 23, 42, 0.32);
}

.preview-article h4 {
  margin-top: 0;
  margin-bottom: 16px;
  font-size: 22px;
}

.preview-article p {
  margin: 0 0 16px;
}

.preview-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.preview-tags span {
  padding: 6px 14px;
  border-radius: 999px;
  border: 1px solid rgba(148, 163, 184, 0.4);
  font-size: 13px;
}

.writer-sidebar {
  display: grid;
  gap: 20px;
}

.sidebar-card {
  background: var(--surface-strong);
  border-radius: var(--radius-md);
  padding: 22px;
  box-shadow: var(--shadow-soft);
}

.sidebar-card.music-card {
  background: linear-gradient(155deg, rgba(255, 255, 255, 0.95), rgba(231, 239, 255, 0.86));
  border-radius: 24px;
  padding: 26px 24px;
  box-shadow: 0 24px 48px rgba(58, 87, 232, 0.14), 0 12px 24px rgba(99, 102, 241, 0.1);
  position: relative;
  overflow: visible;
}

.sidebar-card.music-card::before {
  content: "";
  position: absolute;
  inset: -40% 25% 55% -35%;
  background: radial-gradient(ellipse at 0% 50%, rgba(99, 102, 241, 0.28), transparent 65%);
  opacity: 0.7;
  pointer-events: none;
}

.sidebar-card.music-card::after {
  content: "";
  position: absolute;
  inset: 50% -30% -30% 40%;
  background: radial-gradient(circle at 100% 100%, rgba(96, 165, 250, 0.28), transparent 60%);
  opacity: 0.7;
  pointer-events: none;
}

.music-card h4 {
  position: relative;
  font-size: 18px;
  color: #1f2937;
}

.music-card p {
  position: relative;
  color: rgba(30, 41, 59, 0.7);
}

.music-select {
  position: relative;
  margin-bottom: 18px;
}

.music-select__native {
  position: absolute;
  inset: 0;
  opacity: 0;
  pointer-events: none;
  width: 1px;
  height: 1px;
}

.music-select__trigger {
  width: 100%;
  padding: 16px 52px 16px 20px;
  border-radius: 18px;
  border: 1px solid rgba(99, 102, 241, 0.18);
  background: linear-gradient(135deg, rgba(248, 250, 255, 0.92), rgba(231, 238, 255, 0.88));
  box-shadow: 0 12px 26px rgba(79, 70, 229, 0.12);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  font-size: 15px;
  font-weight: 500;
  color: #1e293b;
  cursor: pointer;
  transition: transform var(--transition), box-shadow var(--transition), border-color var(--transition);
}

.music-select__value {
  flex: 1;
  text-align: left;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.music-select__trigger:hover {
  transform: translateY(-1px);
  box-shadow: 0 18px 32px rgba(79, 70, 229, 0.16);
}

.music-select__trigger:focus-visible {
  outline: 2px solid rgba(99, 102, 241, 0.45);
  outline-offset: 4px;
}

.music-select.is-open .music-select__trigger {
  transform: translateY(-2px);
  border-color: rgba(79, 70, 229, 0.35);
  box-shadow: 0 22px 38px rgba(79, 70, 229, 0.2);
}

.music-select__icon {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: rgba(99, 102, 241, 0.12);
  display: grid;
  place-items: center;
  position: absolute;
  right: 12px;
  top: 50%;
  transform: translateY(-50%);
  transition: transform var(--transition);
}

.music-select__icon::before {
  content: "";
  width: 10px;
  height: 10px;
  border-right: 2px solid rgba(79, 70, 229, 0.8);
  border-bottom: 2px solid rgba(79, 70, 229, 0.8);
  transform: rotate(45deg);
}

.music-select.is-open .music-select__icon {
  transform: translateY(-50%) rotate(180deg);
}

.music-select__menu {
  position: absolute;
  top: calc(100% + 12px);
  left: 0;
  right: 0;
  padding: 10px;
  margin: 0;
  border-radius: 20px;
  border: 1px solid rgba(99, 102, 241, 0.16);
  background: rgba(248, 250, 255, 0.95);
  box-shadow: 0 30px 60px rgba(15, 23, 42, 0.18);
  display: grid;
  gap: 6px;
  max-height: 220px;
  overflow-y: auto;
  backdrop-filter: blur(16px);
  z-index: 20;
}

.music-select__option {
  list-style: none;
  padding: 12px 14px;
  border-radius: 14px;
  font-size: 15px;
  color: #1f2937;
  cursor: pointer;
  transition: background var(--transition), color var(--transition), transform var(--transition);
}

.music-select__option:hover,
.music-select__option:focus,
.music-select__option.is-active {
  background: linear-gradient(120deg, rgba(79, 70, 229, 0.12), rgba(96, 165, 250, 0.12));
  color: #312e81;
}

.music-select__option.is-selected {
  background: linear-gradient(120deg, rgba(79, 70, 229, 0.18), rgba(59, 130, 246, 0.18));
  color: #312e81;
  box-shadow: inset 0 0 0 1px rgba(79, 70, 229, 0.25);
}

.music-select__menu[hidden] {
  display: none;
}



.music-card .btn.secondary {
  position: relative;
  border-radius: 999px;
  padding: 12px 28px;
  font-weight: 600;
  letter-spacing: 0.01em;
  background: linear-gradient(120deg, #4f46e5, #3b82f6);
  color: #f8fafc;
  border: none;
  box-shadow: 0 18px 32px rgba(79, 70, 229, 0.22);
  display: inline-flex;
  align-items: center;
  gap: 10px;
  transition: transform var(--transition), box-shadow var(--transition);
}

.music-card .btn.secondary:hover,
.music-card .btn.secondary:focus-visible {
  transform: translateY(-1px);
  box-shadow: 0 24px 38px rgba(79, 70, 229, 0.26);
}

.music-card .btn.secondary:focus-visible {
  outline: 2px solid rgba(79, 70, 229, 0.4);
  outline-offset: 3px;
}

.music-card .btn.secondary:disabled {
  opacity: 0.72;
  cursor: not-allowed;
  transform: none;
  box-shadow: 0 12px 24px rgba(79, 70, 229, 0.16);
}

.music-card .btn.secondary .btn-icon {
  width: 18px;
  height: 18px;
  border-radius: 50%;
  background: rgba(248, 250, 255, 0.32);
  display: grid;
  place-items: center;
}

.music-card .btn.secondary .btn-icon::before {
  content: "";
  display: block;
  width: 0;
  height: 0;
  border-left: 6px solid rgba(248, 250, 255, 0.9);
  border-top: 4px solid transparent;
  border-bottom: 4px solid transparent;
}

.music-card .btn.secondary .btn-label {
  position: relative;
  z-index: 1;
}

/* Playing state */
.music-card .btn.secondary.playing {
  background: linear-gradient(120deg, #10b981, #059669);
  animation: music-pulse 2s ease-in-out infinite;
}

.music-card .btn.secondary.playing .btn-icon {
  background: rgba(255, 255, 255, 0.24);
}

/* Pause icon when playing */
.music-card .btn.secondary.playing .btn-icon::before {
  border: none;
  width: 8px;
  height: 10px;
  background: linear-gradient(90deg,
    rgba(248, 250, 255, 0.9) 0%,
    rgba(248, 250, 255, 0.9) 30%,
    transparent 30%,
    transparent 70%,
    rgba(248, 250, 255, 0.9) 70%,
    rgba(248, 250, 255, 0.9) 100%
  );
}

@keyframes music-pulse {
  0%, 100% {
    box-shadow: 0 18px 32px rgba(16, 185, 129, 0.28);
  }
  50% {
    box-shadow: 0 24px 40px rgba(16, 185, 129, 0.36);
  }
}

body.dark-shell .music-card .btn.secondary.playing {
  background: linear-gradient(120deg, #059669, #047857);
}

/* Volume Control */
.volume-control {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 18px;
  padding: 12px 16px;
  background: rgba(99, 102, 241, 0.06);
  border-radius: 14px;
}

.volume-label {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 13px;
  font-weight: 500;
  color: #4f46e5;
  white-space: nowrap;
  margin: 0;
}

.volume-label svg {
  opacity: 0.8;
}

.volume-slider {
  flex: 1;
  height: 6px;
  border-radius: 3px;
  background: linear-gradient(90deg, rgba(79, 70, 229, 0.15), rgba(99, 102, 241, 0.2));
  outline: none;
  -webkit-appearance: none;
  appearance: none;
  cursor: pointer;
}

.volume-slider::-webkit-slider-thumb {
  -webkit-appearance: none;
  appearance: none;
  width: 16px;
  height: 16px;
  border-radius: 50%;
  background: linear-gradient(135deg, #4f46e5, #6366f1);
  box-shadow: 0 2px 8px rgba(79, 70, 229, 0.3);
  cursor: pointer;
  transition: transform var(--transition), box-shadow var(--transition);
}

.volume-slider::-webkit-slider-thumb:hover {
  transform: scale(1.15);
  box-shadow: 0 4px 12px rgba(79, 70, 229, 0.4);
}

.volume-slider::-moz-range-thumb {
  width: 16px;
  height: 16px;
  border: none;
  border-radius: 50%;
  background: linear-gradient(135deg, #4f46e5, #6366f1);
  box-shadow: 0 2px 8px rgba(79, 70, 229, 0.3);
  cursor: pointer;
  transition: transform var(--transition), box-shadow var(--transition);
}

.volume-slider::-moz-range-thumb:hover {
  transform: scale(1.15);
  box-shadow: 0 4px 12px rgba(79, 70, 229, 0.4);
}

.volume-value {
  font-size: 13px;
  font-weight: 600;
  color: #4f46e5;
  min-width: 38px;
  text-align: right;
}

body.dark-shell .volume-control {
  background: rgba(96, 165, 250, 0.08);
}

body.dark-shell .volume-label {
  color: #93c5fd;
}

body.dark-shell .volume-slider {
  background: linear-gradient(90deg, rgba(96, 165, 250, 0.15), rgba(129, 140, 248, 0.2));
}

body.dark-shell .volume-value {
  color: #93c5fd;
}

.sidebar-card h4 {
  margin: 0 0 12px;
  font-size: 17px;
  font-weight: 600;
  color: var(--text-strong);
}

.sidebar-card p {
  margin: 0 0 18px;
  font-size: 14px;
  color: var(--text-muted);
}

.calendar {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 6px;
}

.calendar span {
  width: 12px;
  height: 12px;
  border-radius: 3px;
  background: rgba(148, 163, 184, 0.32);
}

.calendar span.filled {
  background: linear-gradient(135deg, #60a5fa, #6366f1);
}

.community {
  padding: 84px 0 120px;
}

.community-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 24px;
}

.community-card {
  background: var(--surface-strong);
  border-radius: var(--radius-lg);
  padding: 28px;
  box-shadow: var(--shadow-soft);
  position: relative;
  overflow: hidden;
}

.community-card::after {
  content: "";
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at top right, rgba(99, 102, 241, 0.25), transparent 60%);
  pointer-events: none;
}

.community-card h4 {
  margin: 0 0 16px;
  font-size: 20px;
  font-family: "Noto Serif SC", serif;
  color: var(--text-strong);
}

.community-card p {
  margin: 0 0 18px;
  color: var(--text-muted);
  font-size: 15px;
}

.pill-strip {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  font-size: 13px;
  color: #434190;
}

.pill-strip span {
  padding: 6px 12px;
  border-radius: 999px;
  background: rgba(99, 102, 241, 0.12);
}

body.dark-shell .note-list li {
  background: rgba(129, 140, 248, 0.14);
}

body.dark-shell .note-list strong {
  color: #c7d2fe;
}

body.dark-shell .preview-tags span {
  border-color: rgba(148, 163, 184, 0.45);
}

body.dark-shell .hero-card {
  background: linear-gradient(145deg, rgba(30, 41, 72, 0.96), rgba(18, 27, 51, 0.86));
  box-shadow: var(--shadow-soft);
}

body.dark-shell .hero-card p {
  color: var(--text-muted);
}

body.dark-shell .floating-card {
  box-shadow: 0 16px 32px rgba(2, 6, 23, 0.55);
}

body.dark-shell .reading-time {
  background: rgba(99, 102, 241, 0.22);
  color: #c7d2fe;
}

.site-footer {
  padding: 28px 0 32px;
  background: rgba(15, 23, 42, 0.95);
  color: rgba(226, 232, 240, 0.88);
}

.footer-inner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 18px;
}

.footer-brand {
  display: flex;
  align-items: center;
  gap: 16px;
}

.site-footer .brand-logo {
  background: rgba(99, 102, 241, 0.18);
  color: #a5b4fc;
}

.footer-links {
  display: flex;
  gap: 18px;
  font-size: 14px;
  color: rgba(226, 232, 240, 0.74);
}

.footer-links a:hover {
  color: white;
}

.footer-note {
  width: 100%;
  font-size: 13px;
  color: rgba(148, 163, 184, 0.7);
}

.reader-modal {
  position: fixed;
  inset: 0;
  display: grid;
  place-items: center;
  z-index: 100;
  opacity: 0;
  pointer-events: none;
  transition: opacity var(--transition);
}

.reader-modal.active {
  opacity: 1;
  pointer-events: all;
}

.modal-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(15, 23, 42, 0.65);
  backdrop-filter: blur(12px);
}

.modal-content {
  position: relative;
  width: min(1020px, 90vw);
  height: min(82vh, 680px);
  background: var(--surface-stronger);
  border-radius: 28px;
  box-shadow: 0 30px 80px rgba(15, 23, 42, 0.35);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.modal-progress {
  padding: 26px 48px 0;
}

.modal-progress .progress-bar {
  width: 100%;
  background: rgba(148, 163, 184, 0.22);
}

body.dark-shell .modal-progress .progress-bar {
  background: rgba(148, 163, 184, 0.32);
}

.modal-close {
  position: absolute;
  top: 18px;
  right: 24px;
  border: none;
  background: rgba(15, 23, 42, 0.08);
  width: 36px;
  height: 36px;
  border-radius: 50%;
  font-size: 20px;
  color: #0f172a;
  cursor: pointer;
}

.modal-reader {
  display: grid;
  grid-template-columns: 220px 1fr;
  height: 100%;
}

.modal-toc {
  background: var(--surface-muted);
  padding: 32px 24px;
  overflow-y: auto;
}

.modal-toc ol {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  gap: 12px;
}

.modal-toc li {
  padding: 10px 12px;
  border-radius: 12px;
  font-size: 14px;
  color: var(--text-muted);
  cursor: pointer;
  transition: background var(--transition), color var(--transition), transform var(--transition);
}

.modal-toc li:hover {
  background: var(--primary-soft);
  color: var(--text-strong);
  transform: translateX(4px);
}

.modal-toc li.active {
  background: rgba(99, 102, 241, 0.16);
  color: var(--primary);
  font-weight: 600;
}

.modal-article {
  padding: 48px;
  overflow-y: auto;
  font-family: "Noto Serif SC", serif;
  line-height: 1.7;
  font-size: 18px;
  background: var(--surface-soft);
}

.modal-article h3 {
  margin-top: 0;
  font-size: 28px;
}

.modal-article p {
  text-align: justify;
  margin: 0 0 18px;
}

.modal-article[data-theme="dusk"] {
  background: #fdf6e3;
  color: #564132;
}

.modal-article[data-theme="dusk"] .chapter-summary {
  color: #93622d;
}

.modal-article[data-theme="night"] {
  background: #0f172a;
  color: #e2e8f0;
}

.modal-article[data-theme="night"] h3 {
  color: #f8fafc;
}

.modal-article[data-theme="night"] .chapter-summary {
  color: #94a3b8;
}

.chapter-summary {
  font-size: 15px;
  color: var(--text-muted);
  margin-top: 8px;
  margin-bottom: 28px;
  font-style: italic;
}

.idea-toast {
  position: fixed;
  bottom: 32px;
  right: 32px;
  background: rgba(15, 23, 42, 0.92);
  color: #f8fafc;
  padding: 14px 20px;
  border-radius: 12px;
  box-shadow: 0 18px 32px rgba(15, 23, 42, 0.25);
  opacity: 0;
  transform: translateY(10px);
  transition: opacity var(--transition), transform var(--transition);
  pointer-events: none;
}

.idea-toast.active {
  opacity: 1;
  transform: translateY(0);
}

@media (max-width: 1080px) {
  .hero-inner {
    grid-template-columns: 1fr;
  }

  .hero-visual {
    display: none;
  }

  .discovery-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .reader-grid {
    grid-template-columns: 1fr;
  }

  .toc {
    position: static;
    display: flex;
    flex-direction: column;
  }

  .writer-grid {
    grid-template-columns: 1fr;
  }

  .community-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 720px) {
  .header-inner {
    flex-wrap: wrap;
    justify-content: center;
  }

  .primary-nav {
    order: 3;
    flex-wrap: wrap;
    justify-content: center;
  }

  .discover,
  .reader-lab,
  .writer-studio,
  .community {
    padding: 60px 0 70px;
  }

  .discovery-grid,
  .community-grid {
    grid-template-columns: 1fr;
  }

  .reader-toolbar {
    flex-direction: column;
    align-items: flex-start;
  }

  .reader-content {
    padding: 26px 24px;
  }

  .reader-search {
    width: 100%;
  }

  .reader-search input {
    flex: 1 1 100%;
    width: 100%;
  }

  .search-controls {
    width: 100%;
    justify-content: flex-start;
  }

  .modal-content {
    width: 94vw;
    height: 88vh;
  }

  .modal-progress {
    padding: 22px 24px 0;
  }

  .modal-reader {
    grid-template-columns: 1fr;
  }

  .modal-toc {
    display: none;
  }
}

/* Global Search Overlay */
.gs-backdrop {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.75);
  backdrop-filter: blur(8px);
  z-index: 9999;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding: 80px 20px 40px;
  overflow-y: auto;
}

body.dark-shell .gs-backdrop {
  background: rgba(0, 0, 0, 0.85);
}

.gs-panel {
  background: var(--surface-stronger);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-soft);
  width: 100%;
  max-width: 720px;
  padding: 28px;
  position: relative;
  max-height: calc(100vh - 160px);
  display: flex;
  flex-direction: column;
  gap: 20px;
}

body.dark-shell .gs-panel {
  background: rgba(15, 23, 42, 0.95);
  box-shadow: 0 24px 48px rgba(0, 0, 0, 0.8);
}

.gs-input {
  width: 100%;
  padding: 16px 20px;
  border-radius: var(--radius-md);
  border: 2px solid var(--border);
  background: var(--surface);
  font-size: 16px;
  color: var(--text-strong);
  font-family: inherit;
  transition: border-color var(--transition), box-shadow var(--transition);
}

.gs-input:focus {
  outline: none;
  border-color: var(--primary);
  box-shadow: 0 0 0 4px var(--primary-soft);
}

body.dark-shell .gs-input {
  background: rgba(30, 41, 59, 0.8);
  border-color: var(--border);
}

.gs-status {
  font-size: 14px;
  color: var(--text-muted);
  min-height: 20px;
  padding: 0 4px;
}

.gs-results {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 16px;
  overflow-y: auto;
  flex: 1;
}

.gs-result-item {
  background: var(--surface-soft);
  border-radius: var(--radius-md);
  padding: 20px;
  cursor: pointer;
  transition: background var(--transition), transform var(--transition),
    box-shadow var(--transition);
  border: 2px solid transparent;
}

.gs-result-item:hover {
  background: var(--surface-strong);
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(15, 23, 42, 0.12);
}

.gs-result-item.is-selected {
  border-color: var(--primary);
  background: var(--primary-soft);
  box-shadow: 0 4px 16px var(--primary-soft);
}

body.dark-shell .gs-result-item {
  background: rgba(30, 41, 59, 0.6);
}

body.dark-shell .gs-result-item:hover {
  background: rgba(30, 41, 59, 0.8);
}

body.dark-shell .gs-result-item.is-selected {
  background: var(--primary-soft);
}

.gs-result-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
  gap: 12px;
}

.gs-result-title {
  font-size: 16px;
  font-weight: 600;
  color: var(--text-strong);
  flex: 1;
}

.gs-result-count {
  font-size: 13px;
  color: var(--text-muted);
  white-space: nowrap;
}

.gs-result-snippets {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.gs-snippet {
  font-size: 14px;
  color: var(--text-body);
  line-height: 1.6;
  font-family: "Noto Serif SC", serif;
}

.gs-snippet mark {
  background: var(--search-hit-bg);
  color: inherit;
  padding: 2px 4px;
  border-radius: 3px;
  font-weight: 600;
}

.gs-result-item.is-selected .gs-snippet mark {
  background: var(--search-hit-current);
  outline: 1px solid var(--search-hit-outline);
}

body.dark-shell .gs-snippet mark {
  background: var(--search-hit-bg);
}

body.dark-shell .gs-result-item.is-selected .gs-snippet mark {
  background: var(--search-hit-current);
  outline: 1px solid var(--search-hit-outline);
}

@media (max-width: 720px) {
  .gs-backdrop {
    padding: 40px 12px 20px;
  }

  .gs-panel {
    padding: 20px;
    max-height: calc(100vh - 80px);
  }

  .gs-result-header {
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
  }
}

/* Bookmarks & Highlights */
.hl {
  background: #fff2ab;
  padding: 0 0.05em;
  border-radius: 2px;
  color: inherit;
  transition: background var(--transition), outline var(--transition);
}

.hl.is-current {
  outline: 2px solid var(--primary);
  background: #ffe58f;
  outline-offset: 1px;
}

body.dark-shell .hl {
  background: rgba(250, 204, 21, 0.35);
}

body.dark-shell .hl.is-current {
  background: rgba(250, 204, 21, 0.55);
  outline-color: #facc15;
}

.reader-content[data-theme="night"] .hl {
  background: rgba(250, 204, 21, 0.25);
  color: #fef3c7;
}

.reader-content[data-theme="night"] .hl.is-current {
  background: rgba(250, 204, 21, 0.45);
  outline-color: #fbbf24;
}

/* Selection Popover */
.selection-popover {
  position: absolute;
  display: none;
  flex-direction: row;
  gap: 8px;
  background: var(--surface-stronger);
  border-radius: var(--radius-md);
  padding: 8px;
  box-shadow: 0 8px 24px rgba(15, 23, 42, 0.2);
  z-index: 100;
  transform: translateX(-50%);
  pointer-events: auto;
}

body.dark-shell .selection-popover {
  background: rgba(15, 23, 42, 0.95);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.6);
}

.selection-popover .btn.small {
  padding: 6px 12px;
  font-size: 13px;
}

/* Annotation Actions in Toolbar */
.annotation-actions {
  display: flex;
  gap: 8px;
  align-items: center;
}

.btn.small {
  padding: 6px 14px;
  font-size: 13px;
}

/* Annotations Panel */
.annotations-panel {
  margin-top: 24px;
  background: var(--surface-soft);
  border-radius: var(--radius-md);
  padding: 16px;
  max-height: 400px;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

body.dark-shell .annotations-panel {
  background: rgba(30, 41, 59, 0.6);
}

.annotations-tabs {
  display: flex;
  gap: 8px;
  margin-bottom: 12px;
  border-bottom: 1px solid var(--border);
  padding-bottom: 8px;
}

.ann-tab {
  background: transparent;
  border: none;
  padding: 6px 12px;
  font-size: 13px;
  color: var(--text-muted);
  cursor: pointer;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  gap: 6px;
  transition: background var(--transition), color var(--transition);
}

.ann-tab:hover {
  background: var(--surface-strong);
  color: var(--text-body);
}

.ann-tab.active {
  color: var(--primary);
  font-weight: 600;
  background: var(--primary-soft);
}

.ann-count {
  background: var(--surface-muted);
  padding: 2px 6px;
  border-radius: 10px;
  font-size: 11px;
  font-weight: 600;
  min-width: 18px;
  text-align: center;
}

.ann-tab.active .ann-count {
  background: var(--primary);
  color: white;
}

.annotations-list {
  overflow-y: auto;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10px;
  min-height: 0;
}

.annotations-empty {
  text-align: center;
  color: var(--text-muted);
  font-size: 13px;
  padding: 24px 12px;
}

.annotation-item {
  background: var(--surface);
  border-radius: var(--radius-sm);
  padding: 12px;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12px;
  cursor: pointer;
  transition: background var(--transition), transform var(--transition),
    box-shadow var(--transition);
  border: 1px solid transparent;
}

.annotation-item:hover {
  background: var(--surface-strong);
  transform: translateX(2px);
  box-shadow: 0 2px 8px rgba(15, 23, 42, 0.1);
}

body.dark-shell .annotation-item {
  background: rgba(30, 41, 59, 0.8);
}

body.dark-shell .annotation-item:hover {
  background: rgba(30, 41, 59, 1);
}

.annotation-content {
  flex: 1;
  min-width: 0;
}

.annotation-snippet {
  font-size: 13px;
  color: var(--text-body);
  line-height: 1.5;
  margin-bottom: 4px;
  font-family: "Noto Serif SC", serif;
}

.annotation-note {
  font-size: 12px;
  color: var(--text-muted);
  margin-top: 6px;
  font-style: italic;
}

.annotation-meta {
  font-size: 11px;
  color: var(--text-muted);
  margin-top: 4px;
}

.annotation-delete {
  background: transparent;
  border: none;
  color: var(--text-muted);
  font-size: 18px;
  line-height: 1;
  padding: 4px 6px;
  cursor: pointer;
  border-radius: var(--radius-sm);
  transition: background var(--transition), color var(--transition);
  flex-shrink: 0;
}

.annotation-delete:hover {
  background: var(--surface-muted);
  color: var(--text-strong);
}

@media (max-width: 720px) {
  .annotations-panel {
    max-height: 300px;
    padding: 12px;
  }

  .annotation-item {
    padding: 10px;
  }

  .selection-popover {
    flex-direction: column;
    transform: translateX(-50%) translateY(-100%);
    margin-top: -8px;
  }
}

/* Bookmarks Drawer */
.bookmarks-drawer {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10000;
  pointer-events: none;
}

.bookmarks-drawer[aria-hidden="true"] {
  display: none;
}

.drawer-backdrop {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.6);
  backdrop-filter: blur(4px);
  pointer-events: auto;
}

body.dark-shell .drawer-backdrop {
  background: rgba(0, 0, 0, 0.75);
}

.drawer-content {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: min(420px, 90vw);
  background: var(--surface-stronger);
  box-shadow: -8px 0 32px rgba(15, 23, 42, 0.25);
  display: flex;
  flex-direction: column;
  pointer-events: auto;
  transform: translateX(0);
  transition: transform var(--transition);
}

body.dark-shell .drawer-content {
  background: rgba(15, 23, 42, 0.98);
  box-shadow: -8px 0 32px rgba(0, 0, 0, 0.8);
}

.drawer-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px 24px;
  border-bottom: 1px solid var(--border);
}

.drawer-header h3 {
  margin: 0;
  font-size: 18px;
  font-weight: 600;
  color: var(--text-strong);
}

.drawer-close {
  background: transparent;
  border: none;
  font-size: 24px;
  line-height: 1;
  color: var(--text-muted);
  cursor: pointer;
  padding: 4px 8px;
  border-radius: var(--radius-sm);
  transition: background var(--transition), color var(--transition);
}

.drawer-close:hover {
  background: var(--surface-muted);
  color: var(--text-strong);
}

.drawer-tabs {
  display: flex;
  gap: 8px;
  padding: 16px 24px;
  border-bottom: 1px solid var(--border);
}

.drawer-tab {
  background: transparent;
  border: none;
  padding: 8px 16px;
  font-size: 14px;
  color: var(--text-muted);
  cursor: pointer;
  border-radius: var(--radius-sm);
  transition: background var(--transition), color var(--transition);
}

.drawer-tab:hover {
  background: var(--surface-strong);
  color: var(--text-body);
}

.drawer-tab.active {
  color: var(--primary);
  font-weight: 600;
  background: var(--primary-soft);
}

.drawer-body {
  flex: 1;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.drawer-list {
  flex: 1;
  overflow-y: auto;
  padding: 16px 24px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.drawer-empty {
  text-align: center;
  color: var(--text-muted);
  font-size: 14px;
  padding: 48px 16px;
}

.drawer-bookmark-item {
  background: var(--surface);
  border-radius: var(--radius-sm);
  padding: 16px;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12px;
  cursor: pointer;
  transition: background var(--transition), transform var(--transition),
    box-shadow var(--transition);
  border: 1px solid transparent;
}

.drawer-bookmark-item:hover {
  background: var(--surface-strong);
  transform: translateX(-2px);
  box-shadow: 0 2px 8px rgba(15, 23, 42, 0.1);
}

body.dark-shell .drawer-bookmark-item {
  background: rgba(30, 41, 59, 0.8);
}

body.dark-shell .drawer-bookmark-item:hover {
  background: rgba(30, 41, 59, 1);
}

.drawer-bookmark-content {
  flex: 1;
  min-width: 0;
}

.drawer-bookmark-title {
  font-size: 15px;
  font-weight: 600;
  color: var(--text-strong);
  margin-bottom: 6px;
  line-height: 1.4;
}

.drawer-bookmark-note {
  font-size: 13px;
  color: var(--text-muted);
  margin-bottom: 6px;
  font-style: italic;
  line-height: 1.4;
}

.drawer-bookmark-meta {
  font-size: 12px;
  color: var(--text-muted);
  display: flex;
  gap: 6px;
  align-items: center;
}

.drawer-bookmark-actions {
  display: flex;
  gap: 8px;
  align-items: center;
  flex-shrink: 0;
}

.drawer-bookmark-locate {
  background: transparent;
  border: none;
  font-size: 20px;
  line-height: 1;
  color: var(--primary);
  cursor: pointer;
  padding: 4px 8px;
  border-radius: var(--radius-sm);
  transition: background var(--transition), transform var(--transition);
}

.drawer-bookmark-locate:hover {
  background: var(--primary-soft);
  transform: translateX(2px);
}

.drawer-bookmark-delete {
  background: transparent;
  border: none;
  font-size: 16px;
  line-height: 1;
  color: var(--text-muted);
  cursor: pointer;
  padding: 4px 8px;
  border-radius: var(--radius-sm);
  transition: background var(--transition), color var(--transition);
}

.drawer-bookmark-delete:hover {
  background: var(--surface-muted);
  color: var(--text-strong);
}

@media (max-width: 720px) {
  .drawer-content {
    width: 100vw;
  }

  .drawer-header,
  .drawer-tabs,
  .drawer-list {
    padding-left: 16px;
    padding-right: 16px;
  }

  .drawer-bookmark-item {
    padding: 12px;
  }
}

/* FAB - Floating Action Button */
.fab-add-bookmark {
  position: fixed;
  right: 24px;
  bottom: 24px;
  width: 56px;
  height: 56px;
  border-radius: 50%;
  background: var(--primary);
  color: white;
  border: none;
  box-shadow: 0 4px 16px rgba(58, 112, 255, 0.4);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  transition: transform var(--transition), opacity var(--transition),
    box-shadow var(--transition), background var(--transition);
  padding: 0;
  /* Safe area support */
  bottom: calc(24px + env(safe-area-inset-bottom));
  right: calc(24px + env(safe-area-inset-right));
}

.fab-add-bookmark:hover {
  transform: scale(1.1);
  box-shadow: 0 6px 20px rgba(58, 112, 255, 0.5);
}

.fab-add-bookmark:active {
  transform: scale(0.95);
}

.fab-add-bookmark[aria-hidden="true"] {
  opacity: 0;
  pointer-events: none;
  transform: scale(0.8);
}

body.dark-shell .fab-add-bookmark {
  background: var(--primary);
  box-shadow: 0 4px 16px rgba(141, 162, 255, 0.4);
}

body.dark-shell .fab-add-bookmark:hover {
  box-shadow: 0 6px 20px rgba(141, 162, 255, 0.5);
}

.fab-icon {
  font-size: 28px;
  line-height: 1;
  font-weight: 300;
  display: block;
}

/* Adjust FAB position when modal progress bar is visible */
body:has(.reader-modal[aria-hidden="false"]) .fab-add-bookmark,
.reader-modal.active ~ .fab-add-bookmark {
  bottom: calc(80px + env(safe-area-inset-bottom));
}

/* Hide FAB when keyboard is focused on mobile */
@media (max-width: 720px) {
  .fab-add-bookmark {
    bottom: calc(20px + env(safe-area-inset-bottom));
    right: calc(20px + env(safe-area-inset-right));
    width: 52px;
    height: 52px;
  }

  .fab-icon {
    font-size: 24px;
  }

  /* Hide FAB when input is focused */
  input:focus ~ * .fab-add-bookmark,
  textarea:focus ~ * .fab-add-bookmark {
    opacity: 0;
    pointer-events: none;
  }
}

/* Bookmark Toast */
.bookmark-toast {
  position: fixed;
  bottom: calc(100px + env(safe-area-inset-bottom));
  left: 50%;
  transform: translateX(-50%) translateY(10px);
  background: rgba(15, 23, 42, 0.92);
  color: white;
  padding: 12px 20px;
  border-radius: var(--radius-md);
  box-shadow: 0 8px 24px rgba(15, 23, 42, 0.3);
  font-size: 14px;
  z-index: 1001;
  opacity: 0;
  pointer-events: none;
  transition: opacity var(--transition), transform var(--transition);
  max-width: calc(100vw - 48px);
  text-align: center;
}

body.dark-shell .bookmark-toast {
  background: rgba(0, 0, 0, 0.9);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.6);
}

.bookmark-toast[aria-hidden="false"] {
  opacity: 1;
  transform: translateX(-50%) translateY(0);
  pointer-events: auto;
}

@media (max-width: 720px) {
  .bookmark-toast {
    bottom: calc(90px + env(safe-area-inset-bottom));
    max-width: calc(100vw - 32px);
    padding: 10px 16px;
    font-size: 13px;
  }
}

/* Service worker update toast */
.update-toast {
  position: fixed;
  left: 50%;
  bottom: calc(20px + env(safe-area-inset-bottom));
  transform: translateX(-50%) translateY(16px);
  display: flex;
  align-items: center;
  gap: 16px;
  background: rgba(15, 23, 42, 0.92);
  color: #f8fafc;
  padding: 12px 18px;
  border-radius: 999px;
  box-shadow: 0 12px 32px rgba(15, 23, 42, 0.32);
  z-index: 1100;
  opacity: 0;
  pointer-events: none;
  transition: opacity var(--transition), transform var(--transition);
  font-size: 14px;
}

.update-toast.is-visible {
  opacity: 1;
  transform: translateX(-50%) translateY(0);
  pointer-events: auto;
}

.update-toast__message {
  font-weight: 500;
  letter-spacing: 0.01em;
}

.update-toast__actions {
  display: flex;
  gap: 8px;
}

.update-toast__action {
  border: none;
  border-radius: 999px;
  padding: 6px 16px;
  font-size: 13px;
  font-weight: 500;
  cursor: pointer;
  transition: background var(--transition), color var(--transition), opacity var(--transition);
}

.update-toast__action--primary {
  background: #3a70ff;
  color: #ffffff;
}

.update-toast__action--primary:hover,
.update-toast__action--primary:focus-visible {
  opacity: 0.88;
}

.update-toast__action--secondary {
  background: transparent;
  color: inherit;
  border: 1px solid rgba(255, 255, 255, 0.24);
}

.update-toast__action--secondary:hover,
.update-toast__action--secondary:focus-visible {
  border-color: rgba(255, 255, 255, 0.4);
}

body.dark-shell .update-toast {
  background: rgba(12, 17, 28, 0.94);
  color: #f8fafc;
  box-shadow: 0 12px 38px rgba(0, 0, 0, 0.45);
}

body.dark-shell .update-toast__action--secondary {
  border-color: rgba(255, 255, 255, 0.32);
}

@media (max-width: 720px) {
  .update-toast {
    max-width: calc(100vw - 32px);
    width: auto;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 16px;
  }

  .update-toast__actions {
    width: 100%;
    justify-content: flex-end;
  }
}
.music-card .btn.secondary {
  position: relative;
  border-radius: 999px;
  padding: 12px 28px;
  font-weight: 600;
  letter-spacing: 0.01em;
  background: linear-gradient(120deg, #4f46e5, #3b82f6);
  color: #f8fafc;
  border: none;
  box-shadow: 0 18px 32px rgba(79, 70, 229, 0.22);
  display: inline-flex;
  align-items: center;
  gap: 10px;
  transition: transform var(--transition), box-shadow var(--transition);
}
.music-card .btn.secondary .btn-icon {
  width: 18px;
  height: 18px;
  border-radius: 50%;
  background: rgba(248, 250, 255, 0.32);
  display: grid;
  place-items: center;
}

.music-card .btn.secondary .btn-icon::before {
  content: "";
  display: block;
  width: 0;
  height: 0;
  border-left: 6px solid rgba(248, 250, 255, 0.9);
  border-top: 4px solid transparent;
  border-bottom: 4px solid transparent;
}
.music-card .btn.secondary .btn-label {
  position: relative;
  z-index: 1;
}
