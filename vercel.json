{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/novel/:slug",
      "destination": "/novel/index.html"
    },
    {
      "source": "/u/:handle",
      "destination": "/u/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/service-worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ]
}
